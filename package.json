{
  "name": "headless-components-workspace",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "Monorepo for headless Vue 3 components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdanpdan/headless-components.git"
  },
  "bugs": {
    "url": "https://github.com/pdanpdan/headless-components/issues"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter playground build",
    "build:packages": "pnpm -r --filter './packages/headless-*' build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm -r --filter './packages/headless-*' run test:coverage",
    "test:all": "pnpm -r run test:all",
    "typecheck": "pnpm -r run typecheck",
    "release": "release-it",
    "release:npm": "pnpm -r run release:npm"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@release-it/conventional-changelog": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vuejs-accessibility": "catalog:",
    "jsdom": "catalog:",
    "release-it": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
