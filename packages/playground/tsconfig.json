{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "#/*": [
        "./*"
      ],
      "@pdanpdan/headless-combobox-vue": [
        "../headless-combobox-vue/src/index.ts"
      ]
    },
    "types": [
      "vite/client",
      "vue"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.vue",
    "env.d.ts",
    "../headless-combobox-vue/src/**/*.ts",
    "../headless-combobox-vue/src/**/*.vue",
    "../headless-combobox-vue/examples/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "pages/**/snippets/**"
  ]
}
